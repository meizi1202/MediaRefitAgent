# MediaRefitAgent 配置文件

# =================== 服务配置 ===================
# API 服务端口
API_PORT=8004

# 前端服务端口
FRONTEND_PORT=8080

# 输出目录
OUTPUT_DIR=F:/video

# =================== FFmpeg 配置 ===================
# FFmpeg bin 目录路径
FFMPEG_PATH=C:/ffmpeg/ffmpeg-9.0-essentials_build/bin

# =================== MiniMax API ===================
# MiniMax API Key
MINIMAX_API_KEY= sk-cp-_DN3TXQjNGsc_UdsYr4Qj1hwNx2wfg4slkEHniC8VBbrY7bTvXr5aR_0AMtfwl8s-gqf-h3xdxzUa42NbyTLaX315HMcfDcmhQmfb9wLwkhrIsTjbndghR4

# MiniMax API Base URL
MINIMAX_API_BASE=https://api.minimax.chat/v1

# MiniMax API URL (chat completion)
MINIMAX_API_URL=https://api.minimax.chat/v1/text/chatcompletion_v2

# MiniMax Model Name
MINIMAX_MODEL_NAME=MiniMax-M2.7

# =================== BGM 音乐库 ===================
# 音乐库目录
MUSIC_LIBRARY_DIR=F:/video/bgm

# =================== Whisper 配置 ===================
# Whisper 模型大小 (tiny/base/small/medium/large)
WHISPER_MODEL=base

# =================== 默认值 ===================
# 默认音色 (Edge-TTS)
DEFAULT_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 默认视频转换策略
DEFAULT_STRATEGY=pad

# 默认目标比例
DEFAULT_TARGET_RATIO=0.5625

# =================== 开发配置 ===================
# Debug 模式
DEBUG=false

# 日志级别
LOG_LEVEL=INFO
