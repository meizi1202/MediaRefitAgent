# ================================================
# MediaRefitAgent - 生产环境配置
# ================================================
# 此文件用于 Docker 部署，不包含敏感信息
# 敏感信息（MINIMAX_API_KEY）通过环境变量注入
# ================================================

# =================== 服务配置 ===================
API_PORT=8004
OUTPUT_DIR=/app/data/outputs

# =================== FFmpeg 配置 ===================
# FFMPEG_DIR 留空，代码会自动从 PATH 检测（已跨平台兼容）
FFMPEG_DIR=
FFMPEG_PRESET_TRANSFORM=ultrafast
FFMPEG_CRF_TRANSFORM=23

# =================== MiniMax API ===================
# MINIMAX_API_KEY 通过环境变量传入，不写在此文件
MINIMAX_API_BASE=https://api.minimax.chat/v1
MINIMAX_API_URL=https://api.minimax.chat/v1/text/chatcompletion_v2
MINIMAX_MODEL_NAME=MiniMax-M2.7

# =================== BGM 音乐库 ===================
MUSIC_LIBRARY_DIR=/app/data/bgm

# =================== Whisper 配置 ===================
WHISPER_MODEL=base

# =================== 默认值 ===================
DEFAULT_TTS_VOICE=zh-CN-XiaoxiaoNeural
DEFAULT_STRATEGY=pad
DEFAULT_TARGET_RATIO=0.5625

# =================== 日志 ===================
DEBUG=false
LOG_LEVEL=INFO
